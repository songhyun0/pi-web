{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "$description": "Project design-token source. Keep synchronized with app/design-tokens.css.",
  "color": {
    "light": {
      "background": "#F7F7F8",
      "panel": "#F1F1F3",
      "raised": "#FFFFFF",
      "hover": "#ECECEF",
      "selected": "#E3E3E7",
      "border": "#E1E1E5",
      "text": "#18181B",
      "textMuted": "#5F5F66",
      "textDim": "#6D6D76",
      "accent": "#27272A",
      "accentHover": "#18181B",
      "accentContrast": "#FFFFFF",
      "accentSoft": "#EDEDF0",
      "success": "#347653",
      "warning": "#8A641F",
      "error": "#A34E5B"
    },
    "dark": {
      "background": "#111113",
      "panel": "#171719",
      "raised": "#1E1E21",
      "hover": "#27272B",
      "selected": "#303035",
      "border": "#2C2C31",
      "text": "#F4F4F5",
      "textMuted": "#B1B1B7",
      "textDim": "#8B8B94",
      "accent": "#F4F4F5",
      "accentHover": "#FFFFFF",
      "accentContrast": "#18181B",
      "accentSoft": "#2A2A2E",
      "success": "#6FA985",
      "warning": "#D4A85E",
      "error": "#D47D89"
    }
  },
  "font": {
    "sans": "Geist Sans, system sans-serif",
    "mono": "Noto Sans Mono, system monospace",
    "size": {
      "xs": "12px",
      "sm": "13px",
      "caption": "14px",
      "body": "15px",
      "bodyComfortable": "16px",
      "subhead": "18px",
      "title": "24px",
      "display": "32px"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "space": {
    "half": "4px",
    "1": "8px",
    "1.5": "12px",
    "2": "16px",
    "3": "24px",
    "4": "32px",
    "5": "40px",
    "6": "48px",
    "8": "64px"
  },
  "radius": {
    "xs": "4px",
    "sm": "8px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "control": {
    "compact": "36px",
    "default": "40px",
    "touch": "44px"
  },
  "layout": {
    "mobileHeader": "56px",
    "utilityRow": "44px",
    "listRow": "48px",
    "contentGutter": "16px",
    "centerMinimum": "480px"
  },
  "shadow": {
    "light": {
      "raised": "0 1px 2px rgba(24, 24, 27, 0.04), 0 8px 24px rgba(24, 24, 27, 0.05)",
      "popover": "0 2px 6px rgba(24, 24, 27, 0.05), 0 16px 40px rgba(24, 24, 27, 0.09)",
      "dialog": "0 4px 12px rgba(24, 24, 27, 0.07), 0 28px 72px rgba(24, 24, 27, 0.13)"
    },
    "dark": {
      "raised": "none",
      "popover": "none",
      "dialog": "none"
    }
  },
  "motion": {
    "press": "80ms",
    "fast": "140ms",
    "exit": "160ms",
    "enter": "200ms",
    "ease": "cubic-bezier(0.4, 0, 0.2, 1)",
    "easeIn": "cubic-bezier(0.4, 0, 1, 1)",
    "easeOut": "cubic-bezier(0, 0, 0.2, 1)"
  },
  "breakpoint": {
    "phoneMax": "640px",
    "compactMax": "1024px"
  }
}
