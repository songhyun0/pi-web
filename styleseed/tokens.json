{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "$description": "Project design-token source. Keep synchronized with app/design-tokens.css.",
  "color": {
    "light": {
      "background": "#F7F8F8",
      "panel": "#EEF1F1",
      "raised": "#FFFFFF",
      "hover": "#E7EBEB",
      "selected": "#DCE6E6",
      "border": "#CDD6D7",
      "text": "#182022",
      "textMuted": "#566366",
      "textDim": "#7A8789",
      "accent": "#23454B",
      "accentHover": "#18363B",
      "accentContrast": "#FFFFFF",
      "accentSoft": "#E3ECEC",
      "success": "#2F6B48",
      "warning": "#8B631F",
      "error": "#9A4E5A"
    },
    "dark": {
      "background": "#0F1415",
      "panel": "#151B1C",
      "raised": "#1C2425",
      "hover": "#222C2D",
      "selected": "#273637",
      "border": "#2D393B",
      "text": "#ECF1F1",
      "textMuted": "#A1ADAF",
      "textDim": "#718083",
      "accent": "#6CAAB1",
      "accentHover": "#83BBC1",
      "accentContrast": "#0D1718",
      "accentSoft": "#1D3032",
      "success": "#66A37A",
      "warning": "#D8A95B",
      "error": "#D07B86"
    }
  },
  "font": {
    "sans": "Geist Sans, system sans-serif",
    "mono": "Noto Sans Mono, system monospace",
    "size": {
      "xs": "11px",
      "sm": "12px",
      "caption": "13px",
      "body": "14px",
      "bodyComfortable": "16px",
      "subhead": "18px",
      "title": "22px",
      "display": "28px"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "space": {
    "half": "4px",
    "1": "8px",
    "1.5": "12px",
    "2": "16px",
    "3": "24px",
    "4": "32px",
    "5": "40px",
    "6": "48px",
    "8": "64px"
  },
  "radius": {
    "xs": "2px",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "full": "9999px"
  },
  "control": {
    "compact": "32px",
    "default": "36px",
    "touch": "44px"
  },
  "shadow": {
    "light": {
      "raised": "0 1px 2px rgba(13, 31, 33, 0.04), 0 8px 24px rgba(13, 31, 33, 0.06)",
      "popover": "0 2px 6px rgba(13, 31, 33, 0.06), 0 16px 40px rgba(13, 31, 33, 0.10)",
      "dialog": "0 4px 12px rgba(13, 31, 33, 0.08), 0 28px 72px rgba(13, 31, 33, 0.14)"
    },
    "dark": {
      "raised": "none",
      "popover": "none",
      "dialog": "none"
    }
  },
  "motion": {
    "press": "60ms",
    "fast": "100ms",
    "exit": "120ms",
    "enter": "180ms",
    "ease": "cubic-bezier(0.4, 0, 0.2, 1)",
    "easeIn": "cubic-bezier(0.4, 0, 1, 1)",
    "easeOut": "cubic-bezier(0, 0, 0.2, 1)"
  },
  "breakpoint": {
    "phoneMax": "640px",
    "compactMax": "1024px"
  }
}
